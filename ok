#!/bin/sh
# Usage: ok $?  — pass the exit code of the previous command
#        ok install bash  — install shell function into ~/.bashrc

if [ "$1" = "install" ] && [ "$2" = "bash" ]; then
    BASHRC="$HOME/.bashrc"
    MARKER="# ok: auto-installed"
    if grep -qF "$MARKER" "$BASHRC" 2>/dev/null; then
        echo "ok is already installed in $BASHRC"
        exit 0
    fi
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    cat >> "$BASHRC" <<EOF

$MARKER
ok() { "$SCRIPT_PATH" "\$?"; }
EOF
    echo "ok installed in $BASHRC — restart your shell or run: source $BASHRC"
    exit 0
fi

code=${1:-0}

if [ "$code" -eq 0 ]; then
    messages="✓ okay
✓ okay, nice!
✓ okay, cool cool cool!
✓ okay — amaze amaze amaze!"
    echo "$messages" | sed -n "$((RANDOM % 4 + 1))p"
    exit 0
fi

# Interpret common exit codes
case "$code" in
    1)   reason="general error" ;;
    2)   reason="misuse of shell built-in" ;;
    126) reason="command not executable — chmod +x, maybe?" ;;
    127) reason="command not found — typo? wrong PATH?" ;;
    128) reason="invalid exit argument" ;;
    129) reason="SIGHUP (hangup)" ;;
    130) reason="SIGINT — Ctrl-C, the universal 'nope'" ;;
    131) reason="SIGQUIT" ;;
    132) reason="SIGILL (illegal instruction)" ;;
    134) reason="SIGABRT (aborted)" ;;
    136) reason="SIGFPE (floating point exception)" ;;
    137) reason="SIGKILL — killed with prejudice" ;;
    138) reason="SIGBUS (bus error)" ;;
    139) reason="SIGSEGV — segmentation fault (memory said no)" ;;
    141) reason="SIGPIPE — broken pipe (nobody was listening)" ;;
    143) reason="SIGTERM (terminated)" ;;
    *)   reason="unknown" ;;
esac

echo "✗ not okay — exit code $code ($reason)"
exit "$code"
