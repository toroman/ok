#!/bin/sh
# Usage: ok        — pass exit code via shell function (after ok install)
#        ok install — install into detected shell (~/.bashrc / ~/.zshrc / fish)
#        ok install bash|zsh|fish — install into specific shell

GREEN='\033[0;32m'
RED='\033[0;31m'
RESET='\033[0m'

_ok_install() {
    shell="$1"
    MARKER="# ok: auto-installed"
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

    case "$shell" in
        bash)
            RC="$HOME/.bashrc"
            grep -qF "$MARKER" "$RC" 2>/dev/null && echo "ok already installed in $RC" && exit 0
            printf '\n%s\nok() { "%s" "$?"; }\n' "$MARKER" "$SCRIPT_PATH" >> "$RC"
            echo "ok installed in $RC — run: source $RC"
            ;;
        zsh)
            RC="$HOME/.zshrc"
            grep -qF "$MARKER" "$RC" 2>/dev/null && echo "ok already installed in $RC" && exit 0
            printf '\n%s\nok() { "%s" "$?"; }\n' "$MARKER" "$SCRIPT_PATH" >> "$RC"
            echo "ok installed in $RC — run: source $RC"
            ;;
        fish)
            FISH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fish/functions"
            FISH_FILE="$FISH_DIR/ok.fish"
            [ -f "$FISH_FILE" ] && echo "ok already installed in $FISH_FILE" && exit 0
            mkdir -p "$FISH_DIR"
            printf 'function ok\n    "%s" $status\nend\n' "$SCRIPT_PATH" > "$FISH_FILE"
            echo "ok installed in $FISH_FILE"
            ;;
        *)
            echo "Unknown shell: $shell. Supported: bash, zsh, fish" >&2
            exit 1
            ;;
    esac
    exit 0
}

if [ "$1" = "install" ]; then
    if [ -n "$2" ]; then
        _ok_install "$2"
    else
        detected="$(basename "${SHELL:-}")"
        case "$detected" in
            bash|zsh|fish) _ok_install "$detected" ;;
            *) echo "Could not detect shell. Run: ok install bash|zsh|fish" >&2; exit 1 ;;
        esac
    fi
fi

code=${1:-0}

if [ "$code" -eq 0 ]; then
    messages="✓ okay
✓ okay, nice!
✓ okay, cool cool cool!
✓ okay — amaze amaze amaze!"
    printf "${GREEN}%s${RESET}\n" "$(echo "$messages" | sed -n "$((RANDOM % 4 + 1))p")"
    exit 0
fi

case "$code" in
    1)   reason="general error" ;;
    2)   reason="misuse of shell built-in" ;;
    126) reason="command not executable — chmod +x, maybe?" ;;
    127) reason="command not found — typo? wrong PATH?" ;;
    128) reason="invalid exit argument" ;;
    129) reason="SIGHUP (hangup)" ;;
    130) reason="SIGINT — Ctrl-C, the universal 'nope'" ;;
    131) reason="SIGQUIT" ;;
    132) reason="SIGILL (illegal instruction)" ;;
    134) reason="SIGABRT (aborted)" ;;
    136) reason="SIGFPE (floating point exception)" ;;
    137) reason="SIGKILL — killed with prejudice" ;;
    138) reason="SIGBUS (bus error)" ;;
    139) reason="SIGSEGV — segmentation fault (memory said no)" ;;
    141) reason="SIGPIPE — nobody was listening" ;;
    143) reason="SIGTERM (terminated)" ;;
    *)   reason="unknown" ;;
esac

printf "${RED}✗ not okay — exit code %s (%s)${RESET}\n" "$code" "$reason"
exit "$code"
